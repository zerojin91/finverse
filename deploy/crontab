# FINVERSE 수집 스케줄. 설치: crontab deploy/crontab
# Ubuntu 서버와 cron은 UTC 기준이다. 한국 시간은 주석에 병기한다.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 10:00 UTC = 19:00 KST, 평일 — KRX 수집 후 DB 적재.
0 10 * * 1-5 cd /home/ubuntu/finverse && scripts/run_ingest.sh update --only market_ingest --load >> logs/cron.log 2>&1

# 장중 지수는 FINVERSE DB에 먼저 적재하고 화면은 DB만 조회한다.
*/5 0-6 * * 1-5 cd /home/ubuntu/finverse && npm run sync:indices -- --group domestic >> logs/cron.log 2>&1
*/10 13-22 * * 1-5 cd /home/ubuntu/finverse && npm run sync:indices -- --group foreign >> logs/cron.log 2>&1

# 20:30 UTC = 05:30 KST, 매일 — 경제·뉴스 수집 후 DB 적재.
30 20 * * * cd /home/ubuntu/finverse && scripts/run_ingest.sh update --skip market_ingest --load >> logs/cron.log 2>&1

# 18:00 UTC 토요일 = 03:00 KST 일요일 — Naver 시세 정정분.
0 18 * * 6 cd /home/ubuntu/finverse && flock -n data/.ingest_all.lock python3 collectors/market_ingest.py update --source naver --lookback-days 30 --no-flows >> logs/cron.log 2>&1

# 11:00 UTC = 20:00 KST, 평일 장마감 후 1회 — 최신 적재 데이터로 Bedrock 요약 후 DB 저장.
0 11 * * 1-5 cd /home/ubuntu/finverse && scripts/run_bedrock_signal_update.sh >> logs/cron.log 2>&1

# 19:00 UTC = 04:00 KST, 매일 — 30일 지난 로그 정리.
0 19 * * * find /home/ubuntu/finverse/logs -name '*.log' -mtime +30 -delete
