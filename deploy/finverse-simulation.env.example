# Keep this file on the collector server as deploy/finverse-simulation.env.
# Do not commit real credentials.
FINVERSE_SIMULATION_API_PORT=8010
FINVERSE_SIMULATION_API_TOKEN=replace-with-a-long-random-token
FINVERSE_SIMULATION_PIPELINE_VERSION=2026-08-24-mirofish-adapter-v2
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-a-long-random-password

# MiroFish-compatible OpenAI endpoint. FINVERSE currently uses OpenRouter.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=deepseek/deepseek-v4-flash-0731
# Used only if the primary model errors or returns an empty response.
FINVERSE_OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,poolside/laguna-s-2.1:free
# Bounds a single unresponsive provider request.  DeepSeek reasoning is disabled
# by the FINVERSE runtime because ontology generation requires JSON text.
FINVERSE_OPENROUTER_REQUEST_TIMEOUT_SECONDS=60
# OASIS simulation calls use one retry after a transient provider failure.
FINVERSE_SIMULATION_LLM_MAX_RETRIES=1
# MiroFish-Offline /api/simulation/prepare uses five parallel profile workers.
FINVERSE_PROFILE_PARALLEL_COUNT=5
# Maximum simultaneous OASIS LLM calls inside one platform batch.
FINVERSE_SIMULATION_LLM_CONCURRENCY=1
# Expensive OASIS batches shared across Twitter and Reddit. Keep at 1 on the
# 4 GB collector host so only one platform allocates LLM work at a time.
FINVERSE_SIMULATION_GLOBAL_LLM_BATCHES=1

# Neo4j semantic search embeddings (OpenRouter OpenAI-compatible endpoint).
OPENROUTER_API_KEY=
FINVERSE_EMBEDDING_MODEL=baai/bge-m3
FINVERSE_EMBEDDING_DIMENSIONS=1024
FINVERSE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
