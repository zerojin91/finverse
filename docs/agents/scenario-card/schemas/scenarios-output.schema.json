{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finverse/scenario-card/scenarios_output/v1",
  "title": "ScenariosOutput",
  "type": "object",
  "required": ["scenarios", "meta"],
  "additionalProperties": false,
  "properties": {
    "scenarios": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "scenario-card.schema.json" }
    },
    "meta": {
      "type": "object",
      "required": ["generated_at", "as_of", "target"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "as_of": { "type": "string", "format": "date" },
        "target": { "type": "string" },
        "horizon": { "type": "string" },
        "volume_regime": { "$ref": "volume-regime.schema.json" }
      }
    }
  }
}
