{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finverse/scenario-card/scenario_card/v1",
  "title": "ScenarioCard",
  "type": "object",
  "required": [
    "id", "title", "duration", "tags", "forecast", "tone",
    "summary", "thesis", "context",
    "chapters", "investorGuide", "studyGuide", "biasChecks",
    "path", "events", "agentInsights", "riskPoints"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "duration": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 4 },
    "forecast": { "type": "string" },
    "tone": { "type": "string", "enum": ["up", "down", "neutral"] },
    "image": { "type": "string", "format": "uri" },
    "summary": { "type": "string", "minLength": 50 },
    "thesis": { "type": "string", "minLength": 10 },
    "context": { "type": "string", "minLength": 10 },
    "chapters": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "body", "evidence"],
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "investorGuide": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["stance", "action", "rationale"],
        "properties": {
          "stance": { "type": "string" },
          "action": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "studyGuide": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["topic", "question"],
        "properties": {
          "topic": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    },
    "biasChecks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["bias", "trap", "counter"],
        "properties": {
          "bias": { "type": "string" },
          "trap": { "type": "string" },
          "counter": { "type": "string" }
        }
      }
    },
    "path": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "type": "number" }
    },
    "events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["week", "category", "title", "body", "impact"],
        "properties": {
          "week": { "type": "string" },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "impact": { "type": "string", "pattern": "^[+-][0-9]+\\.[0-9]+%$" }
        }
      }
    },
    "agentInsights": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["role", "title", "body"],
        "properties": {
          "role": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" }
        }
      }
    },
    "riskPoints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" }
    }
  }
}
