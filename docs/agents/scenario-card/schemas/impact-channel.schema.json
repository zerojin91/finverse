{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finverse/scenario-card/impact_channel/v1",
  "title": "ImpactChannel",
  "type": "object",
  "required": ["scenario_id", "base_index", "evidence_sufficient", "evidence_confidence", "events"],
  "additionalProperties": false,
  "properties": {
    "scenario_id": { "type": "string" },
    "base_index": { "type": "number", "exclusiveMinimum": 0 },
    "evidence_sufficient": { "type": "boolean" },
    "evidence_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "analog_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "anchor_date", "similarity_score"],
        "properties": {
          "case_id": { "type": "string" },
          "anchor_date": { "type": "string", "format": "date" },
          "similarity_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "match_points": { "type": "array", "items": { "type": "string" } },
          "diff_points": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["event_key", "I_quant_pct", "I_analyst_pct", "channel_confidence"],
        "additionalProperties": false,
        "properties": {
          "event_key": { "type": "string" },
          "analog_observations": {
            "type": "object",
            "properties": {
              "n_cases": { "type": "integer", "minimum": 0 },
              "return_median_pct": { "type": "number" },
              "return_p25_pct": { "type": "number" },
              "return_p75_pct": { "type": "number" }
            }
          },
          "I_quant_pct": { "type": "number" },
          "I_analyst_pct": { "type": "number" },
          "I_news_pct": { "type": ["number", "null"] },
          "channel_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
