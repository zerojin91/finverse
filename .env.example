# Keep real values only in the collector server's finverse/.env. Never commit .env.
ECOS_API_KEY=
KOSIS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_ID_HASH_SALT=
FRED_API_KEY=
# KRX Open API. Free, valid one year. Each content type also needs its own
# "API 이용신청" filed in the KRX service list or that endpoint returns 401.
KRX_AUTH_KEY=
FINCEPT_API_BASE_URL=https://api.fincept.in
FINCEPT_API_KEY=
FINCEPT_SESSION_TOKEN=
# Optional outbound proxy and collector identification.
HTTP_PROXY=
HTTPS_PROXY=
FINVERSE_COLLECTOR_USER_AGENT=FinverseCollector/1.0 (personal research contact: replace-me)

# PostgreSQL data lake (docker compose up -d db). See docs/database.md.
POSTGRES_DB=finverse
POSTGRES_USER=finverse
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Bind address. 127.0.0.1 keeps the database private to the host.
# Set 0.0.0.0 only for external hosting, and restrict the port to known source
# IPs in the AWS security group first. See docs/database.md.
POSTGRES_BIND=127.0.0.1
# Full URL for clients (psql, BI tools, the web app).
# MiroFish reads FINVERSE_DB_NAME through SSH + docker exec + psql; no DB URL or DB password is needed.
FINVERSE_DB_NAME=finverse
FINVERSE_DB_CONTAINER=finverse-db
FINVERSE_DB_SSH_TIMEOUT_SECONDS=90

# Local KOSPI live-data bridge. The PEM file itself must never be committed.
FINVERSE_SSH_KEY=D:\finverse_key.pem
FINVERSE_SSH_HOST=ubuntu@44.206.56.75
# Set to 1 when the key is stored inside WSL with chmod 400. The KOSPI bridge
# then runs its SSH hop through WSL instead of using the Windows-mounted key.
FINVERSE_SSH_USE_WSL=0
FINVERSE_WSL_DISTRO=Ubuntu
FINVERSE_WSL_SSH_KEY=~/.ssh/finverse_key.pem
FINVERSE_KOSPI_BRIDGE_PORT=5439
FINVERSE_KOSPI_BRIDGE_URL=http://127.0.0.1:5439

# OpenRouter is the only required LLM credential.
# The default model is DeepSeek V4 Flash 0731. It is billed by OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OpenRouter tries these in order when the primary model cannot complete a request.
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,dots-studio/dots-3-note-preview:free,poolside/laguna-s-2.1:free

# Optional direct MiroFish Python pipeline.  This does not call the MiroFish
# Flask API; it imports the local MiroFish-Offline services from this path.
MIROFISH_OFFLINE_PATH=C:\Users\user\Documents\MiroFish-Offline
# Defaults use OPENROUTER_API_KEY when these are blank.
MIROFISH_LLM_API_KEY=
MIROFISH_LLM_BASE_URL=https://openrouter.ai/api/v1
MIROFISH_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# MiroFish uses Neo4j and OpenRouter BAAI BGE-M3 for GraphRAG embeddings.
MIROFISH_NEO4J_URI=bolt://localhost:7687
MIROFISH_NEO4J_USER=neo4j
MIROFISH_NEO4J_PASSWORD=mirofish
FINVERSE_EMBEDDING_MODEL=baai/bge-m3
FINVERSE_EMBEDDING_DIMENSIONS=1024
FINVERSE_EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
FINVERSE_EMBEDDING_TIMEOUT_SECONDS=90

# Optional remote Neo4j + MiroFish runtime. Leave empty to use the local
# development pipeline. In production this points to a PEM SSH tunnel only.
FINVERSE_SIMULATION_API_URL=
FINVERSE_SIMULATION_API_TOKEN=
FINVERSE_SIMULATION_TUNNEL_ENABLED=0
FINVERSE_SIMULATION_TUNNEL_PORT=8010
FINVERSE_SIMULATION_REMOTE_PORT=8010

# ===== 페이퍼 트레이딩 엔진 =====
# 엔진은 이 저장소 안에서 돕니다(services/paper_trading). `npm run dev`가
# 함께 띄우고, /api/paper-trading/* 프록시가 이 주소로 중계합니다.
FINVERSE_FINSIM_API_URL=http://127.0.0.1:5055
FINVERSE_PAPER_TRADING_PORT=5055
# 저장된 모의 투자 게임 위치(기본: var/paper_games)
# FINVERSE_PAPER_TRADING_DIR=

# KOSPI 시세·투자자 수급·경제지표를 읽는 읽기 전용 PostgreSQL 접속.
# 시나리오 생성에 반드시 필요합니다.
FINVERSE_DATABASE_URL=postgresql://readonly_user:password@127.0.0.1:5432/finverse

# 시뮬레이션 LLM. OPENROUTER_API_KEY가 있으면 로컬 추론 대신 이쪽을 씁니다.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_FALLBACK_MODELS=minimax/minimax-m3:free
# 같은 모델도 프로바이더에 따라 처리량이 17배까지 갈립니다. 처리량으로 고정합니다.
OPENROUTER_PROVIDER_SORT=throughput
OPENROUTER_MAX_TOKENS=8192
