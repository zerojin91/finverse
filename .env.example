# Keep real values only in the collector server's finverse/.env. Never commit .env.
ECOS_API_KEY=
KOSIS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_ID_HASH_SALT=
FRED_API_KEY=
FINCEPT_API_BASE_URL=https://api.fincept.in
FINCEPT_API_KEY=
FINCEPT_SESSION_TOKEN=
# Optional outbound proxy and collector identification.
HTTP_PROXY=
HTTPS_PROXY=
FINVERSE_COLLECTOR_USER_AGENT=FinverseCollector/1.0 (personal research contact: replace-me)

# Local read-only dashboard database. Keep real values in .env.local only.
FINVERSE_DB_HOST=
FINVERSE_DB_PORT=5432
FINVERSE_DB_NAME=
FINVERSE_DB_USER=
FINVERSE_DB_PASSWORD=
