# Keep real values only in the collector server's finverse/.env. Never commit .env.
ECOS_API_KEY=
KOSIS_API_KEY=
YOUTUBE_API_KEY=
YOUTUBE_ID_HASH_SALT=
FRED_API_KEY=
# KRX Open API. Free, valid one year. Each content type also needs its own
# "API 이용신청" filed in the KRX service list or that endpoint returns 401.
KRX_AUTH_KEY=
FINCEPT_API_BASE_URL=https://api.fincept.in
FINCEPT_API_KEY=
FINCEPT_SESSION_TOKEN=
# Optional outbound proxy and collector identification.
HTTP_PROXY=
HTTPS_PROXY=
FINVERSE_COLLECTOR_USER_AGENT=FinverseCollector/1.0 (personal research contact: replace-me)

# PostgreSQL data lake (docker compose up -d db). See docs/database.md.
POSTGRES_DB=finverse
POSTGRES_USER=finverse
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Bind address. 127.0.0.1 keeps the database private to the host.
# Set 0.0.0.0 only for external hosting, and restrict the port to known source
# IPs in the AWS security group first. See docs/database.md.
POSTGRES_BIND=127.0.0.1
# Full URL for clients (psql, BI tools, the web app).
# DATABASE_URL=postgresql://finverse:PASSWORD@HOST:5432/finverse?sslmode=require
