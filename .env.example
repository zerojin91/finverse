# Keep real values only in the collector server's finverse/.env. Never commit .env.
ECOS_API_KEY=
KOSIS_API_KEY=
KRX_AUTH_KEY=
YOUTUBE_API_KEY=
YOUTUBE_ID_HASH_SALT=
FRED_API_KEY=
FINCEPT_API_BASE_URL=https://api.fincept.in
FINCEPT_API_KEY=
FINCEPT_SESSION_TOKEN=
# Optional outbound proxy and collector identification.
HTTP_PROXY=
HTTPS_PROXY=
FINVERSE_COLLECTOR_USER_AGENT=FinverseCollector/1.0 (personal research contact: replace-me)

# Local read-only dashboard database. Keep real values in .env.local only.
FINVERSE_DB_HOST=
FINVERSE_DB_PORT=5432
FINVERSE_DB_NAME=
FINVERSE_DB_USER=
FINVERSE_DB_PASSWORD=

# Bedrock configuration. On EC2, copy these values to /home/ubuntu/finverse/.env.
# An IAM role is preferable to long-lived keys when the deployment supports it.
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic.claude-sonnet-5
BEDROCK_MODEL_ID=global.anthropic.claude-opus-4-6-v1

# Optional local-development fallback; production does not need this file.
CLAUDE_BEDROCK_SETTINGS_PATH=~/.claude-bedrock/settings.json
